# Replace all credential placeholders before starting MCP.
MCP_AUTH_TOKEN=replace-with-a-long-random-token
ANSWER_AGENT_EMAIL=agent@example.com
ANSWER_AGENT_PASSWORD=replace-with-agent-account-password
ANSWER_PORT=9080
MCP_PORT=9081
# Add the public MCP hostname here when configuring an HTTPS reverse proxy.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
